FoamFile
{
  version    2.0;
  format    ascii;
  class    dictionary;
  object    fvSolution;
}
solvers
{
  Phi
  {
    solver    PCG;
    preconditioner    DIC;
    tolerance    1e-6;
    relTol    0.01;
  }
  p_rgh
  {
    solver    PCG;
    preconditioner    DIC;
    tolerance    1e-6;
    relTol    0.01;
    minIter    3;
  }
  "(U|h|e|k|omega|epsilon)"
  {
    solver    PBiCGStab;
    preconditioner    DILU;
    tolerance    1e-8;
    relTol    0.01;
  }
}
SIMPLE
{
  nNonOrthogonalCorrectors    1;
  pRefCell    0;
  pRefValue    0;
  residualControl
  {
    p_rgh    1e-4;
    U    1e-4;
    "(h|e)"    1e-4;
    "(k|omega|epsilon)"    1e-4;
  }
}
potentialFlow
{
  nNonOrthogonalCorrectors    10;
}
relaxationFactors
{
  fields
  {
    rho    1.0;
    p_rgh    0.3;
  }
  equations
  {
    U    0.3;
    "(h|e)"    0.3;
    "(k|omega|epsilon).*"    0.3;
  }
}
