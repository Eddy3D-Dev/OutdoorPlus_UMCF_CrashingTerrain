FoamFile
{
  version    2.0;
  format    ascii;
  class    dictionary;
  location    "system";
  object    controlDict;
}
application    buoyantSimpleFoam;
startFrom    startTime;
startTime    0;
stopAt    endTime;
endTime    1000;
deltaT    1;
writeControl    timeStep;
writeInterval    5;
purgeWrite    0;
writeFormat    binary;
writePrecision    8;
writeCompression    off;
timeFormat    general;
timePrecision    12;
runTimeModifiable    true;
