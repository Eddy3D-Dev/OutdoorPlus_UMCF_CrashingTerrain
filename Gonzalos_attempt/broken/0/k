FoamFile
{
  version    2.0;
  format    ascii;
  class    volScalarField;
  location    "0";
  object    k;
}
dimensions    [0 2 -2 0 0 0 0];
internalField    uniform 1.0;
boundaryField
{
  left
  {
    type    zeroGradient;
  }
  right
  {
    type    zeroGradient;
  }
  top
  {
    type    zeroGradient;
  }
  terrain
  {
    type    kqRWallFunction;
    value    uniform 1.0;
  }
  back
  {
    type    zeroGradient;
  }
  front
  {
    // Using simple fixedValue for robustness comparison with working case
    type    fixedValue; 
    value    uniform 1.0;
  }
  buildings
  {
    type    kqRWallFunction;
    value    uniform 1.0;
  }
}
