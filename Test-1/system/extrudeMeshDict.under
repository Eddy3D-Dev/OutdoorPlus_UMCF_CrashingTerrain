FoamFile
{
  version    2.0;
  format    ascii;
  class    dictionary;
  object    extrudeMeshDict;
}
constructFrom    surface;
surface    "constant/triSurface/underground.stl";
flipNormals    true;
extrudeModel    linearDirection;
nLayers    4;
expansionRatio    1.2;
linearDirectionCoeffs
{
  direction    (0 0 -1);
  thickness    5;
}
mergeFaces    false;
mergeTol    0;
